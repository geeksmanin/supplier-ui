package {{PACKAGE_NAME}};

import android.app.AlertDialog;
import android.app.DownloadManager;
import android.content.Context;
import android.content.SharedPreferences;
import android.graphics.Color;
import android.net.Uri;
import android.os.Bundle;
import android.os.Environment;
import android.view.ViewGroup;
import android.webkit.CookieManager;
import android.webkit.URLUtil;
import android.webkit.WebResourceError;
import android.webkit.WebResourceRequest;
import android.webkit.WebView;
import android.widget.Toast;
import com.getcapacitor.BridgeActivity;
import com.getcapacitor.BridgeWebViewClient;
import com.capacitorjs.plugins.pushnotifications.PushNotificationsPlugin;
import com.capacitorjs.plugins.app.AppPlugin;
import com.capacitorjs.plugins.splashscreen.SplashScreenPlugin;
import com.capacitorjs.plugins.statusbar.StatusBarPlugin;
import com.capacitorjs.plugins.filesystem.FilesystemPlugin;
import com.capacitorjs.plugins.share.SharePlugin;

public class MainActivity extends BridgeActivity {
    private static final String PREF_NAME = "GeeksmanAppConfig";
    private static final String KEY_SERVER_URL = "custom_server_url";
    private GalaxyLoaderView galaxyLoaderView;
    private volatile boolean hasCustomLoadCompleted = false;
    private volatile boolean isServerDialogShowing = false;

    private static String normalizeUrl(String url) {
        if (url == null) return "";
        String trimmed = url.trim();
        while (trimmed.endsWith("/")) {
            trimmed = trimmed.substring(0, trimmed.length() - 1);
        }
        return trimmed;
    }

    private boolean isDefaultServerUrl(String url) {
        String normUrl = normalizeUrl(url);
        if (normUrl.isEmpty()) return false;
        String defaultUrl = bridge != null ? bridge.getServerUrl() : "";
        String normDefault = normalizeUrl(defaultUrl);
        return !normDefault.isEmpty() && normUrl.equalsIgnoreCase(normDefault);
    }

    @Override
    public void onCreate(Bundle savedInstanceState) {
        registerPlugin(PushNotificationsPlugin.class);
        registerPlugin(AppPlugin.class);
        registerPlugin(SplashScreenPlugin.class);
        registerPlugin(StatusBarPlugin.class);
        registerPlugin(FilesystemPlugin.class);
        registerPlugin(SharePlugin.class);
        registerPlugin(DevServerPlugin.class);

        super.onCreate(savedInstanceState);

        // Mount native GalaxyLoaderView directly over the window
        galaxyLoaderView = new GalaxyLoaderView(this, "{{SPLASH_BACKGROUND}}");
        addContentView(galaxyLoaderView, new ViewGroup.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.MATCH_PARENT
        ));

        String activeCustomDevUrl = null;

        // Configure WebView styling, error handling, downloads, and load dev URL
        if (this.bridge != null && this.bridge.getWebView() != null) {
            WebView webView = this.bridge.getWebView();
            try {
                webView.setBackgroundColor(Color.parseColor("{{SPLASH_BACKGROUND}}"));
            } catch (Exception ignored) {}

            android.webkit.WebSettings webSettings = webView.getSettings();
            webSettings.setDomStorageEnabled(true);
            webSettings.setDatabaseEnabled(true);
            webSettings.setCacheMode(android.webkit.WebSettings.LOAD_DEFAULT);

            setupConnectionErrorHandler();
            setupDownloadListener();

            SharedPreferences prefs = getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
            String customUrl = prefs.getString(KEY_SERVER_URL, null);
            if (customUrl != null && !customUrl.trim().isEmpty()) {
                if (isDefaultServerUrl(customUrl)) {
                    // Self-heal stale production URL stored as custom override
                    prefs.edit().remove(KEY_SERVER_URL).apply();
                } else {
                    activeCustomDevUrl = customUrl.trim();
                    webView.loadUrl(activeCustomDevUrl);
                }
            }
        }

        // Safety watchdog: ensure splash and loader never block the UI for more than 3 seconds
        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(() -> {
            dismissGalaxyLoader();
        }, 3000);

        // Dev-server-only watchdog: only fires if a non-production dev server failed to commit
        if (activeCustomDevUrl != null) {
            final String watchedDevUrl = activeCustomDevUrl;
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(() -> {
                if (hasCustomLoadCompleted || isFinishing() || isDestroyed()) {
                    return;
                }
                SharedPreferences prefs = getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
                String currentPref = prefs.getString(KEY_SERVER_URL, null);
                if (currentPref != null && !currentPref.trim().isEmpty() && !isDefaultServerUrl(currentPref)) {
                    if (bridge != null && bridge.getWebView() != null) {
                        String currentUrl = bridge.getWebView().getUrl();
                        int progress = bridge.getWebView().getProgress();
                        if (progress < 20 || currentUrl == null || currentUrl.equals("about:blank") || currentUrl.startsWith("data:")) {
                            showServerUnreachableDialog(watchedDevUrl);
                        }
                    }
                }
            }, 6000);
        }
    }

    public void dismissGalaxyLoader() {
        runOnUiThread(() -> {
            if (galaxyLoaderView != null) {
                galaxyLoaderView.dismiss(null);
            }
            try {
                if (bridge != null) {
                    com.getcapacitor.PluginHandle splash = bridge.getPlugin("SplashScreen");
                    if (splash != null && splash.getInstance() != null) {
                        ((com.capacitorjs.plugins.splashscreen.SplashScreenPlugin) splash.getInstance()).hide(null);
                    }
                }
            } catch (Exception ignored) {}
        });
    }

    private boolean isInternalOrDevUrl(Uri uri) {
        if (uri == null) return false;
        String host = uri.getHost();
        if (host == null) return false;

        SharedPreferences prefs = getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
        String customUrl = prefs.getString(KEY_SERVER_URL, null);
        if (customUrl != null && !customUrl.trim().isEmpty()) {
            try {
                Uri customUri = Uri.parse(customUrl.trim());
                if (host.equalsIgnoreCase(customUri.getHost())) {
                    return true;
                }
            } catch (Exception ignored) {}
        }

        // Local LAN, loopback, and emulator addresses
        return host.startsWith("192.168.") ||
               host.startsWith("10.") ||
               host.matches("^172\\.(1[6-9]|2[0-9]|3[0-1])\\..*") ||
               host.equals("10.0.2.2") ||
               host.equals("localhost") ||
               host.endsWith(".local");
    }

    private void setupConnectionErrorHandler() {
        if (this.bridge == null || this.bridge.getWebView() == null) return;

        WebView webView = this.bridge.getWebView();
        webView.setWebViewClient(new BridgeWebViewClient(this.bridge) {
            @Override
            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
                if (request != null && isInternalOrDevUrl(request.getUrl())) {
                    return false; // Keep inside WebView, DO NOT launch external browser
                }
                return super.shouldOverrideUrlLoading(view, request);
            }

            @Override
            public boolean shouldOverrideUrlLoading(WebView view, String urlStr) {
                if (urlStr != null && isInternalOrDevUrl(Uri.parse(urlStr))) {
                    return false; // Keep inside WebView
                }
                return super.shouldOverrideUrlLoading(view, urlStr);
            }

            @Override
            public void onPageCommitVisible(WebView view, String url) {
                super.onPageCommitVisible(view, url);
                if (url != null && !url.equals("about:blank") && !url.startsWith("data:")) {
                    hasCustomLoadCompleted = true;
                    dismissGalaxyLoader();
                }
            }

            @Override
            public void onPageFinished(WebView view, String url) {
                super.onPageFinished(view, url);
                if (url != null && !url.equals("about:blank") && !url.startsWith("data:")) {
                    hasCustomLoadCompleted = true;
                    dismissGalaxyLoader();
                }
            }

            @Override
            public void onReceivedError(WebView view, WebResourceRequest request, WebResourceError error) {
                super.onReceivedError(view, request, error);
                if (error != null && error.getDescription() != null && error.getDescription().toString().contains("ERR_ABORTED")) {
                    return;
                }
                if (request != null && request.isForMainFrame()) {
                    runOnUiThread(() -> {
                        dismissGalaxyLoader();
                        handleMainFrameError(view, request.getUrl().toString());
                    });
                }
            }

            @SuppressWarnings("deprecation")
            @Override
            public void onReceivedError(WebView view, int errorCode, String description, String failingUrl) {
                super.onReceivedError(view, errorCode, description, failingUrl);
                if (errorCode == ERROR_UNKNOWN && description != null && description.contains("ERR_ABORTED")) {
                    return;
                }
                String currentUrl = view != null ? view.getUrl() : null;
                if (failingUrl != null && (failingUrl.equals(currentUrl) || currentUrl == null)) {
                    runOnUiThread(() -> {
                        dismissGalaxyLoader();
                        handleMainFrameError(view, failingUrl);
                    });
                }
            }

            @Override
            public void onReceivedHttpError(WebView view, WebResourceRequest request, android.webkit.WebResourceResponse errorResponse) {
                super.onReceivedHttpError(view, request, errorResponse);
                if (request != null && request.isForMainFrame() && errorResponse != null && errorResponse.getStatusCode() >= 400) {
                    runOnUiThread(() -> {
                        dismissGalaxyLoader();
                        handleMainFrameError(view, request.getUrl().toString());
                    });
                }
            }

            @Override
            public void onReceivedSslError(WebView view, android.webkit.SslErrorHandler handler, android.net.http.SslError error) {
                if (error != null && error.getUrl() != null && isInternalOrDevUrl(Uri.parse(error.getUrl()))) {
                    handler.proceed();
                } else {
                    super.onReceivedSslError(view, handler, error);
                    runOnUiThread(() -> {
                        dismissGalaxyLoader();
                        showServerUnreachableDialog(error != null ? error.getUrl() : "SSL Error");
                    });
                }
            }
        });
    }

    private void setupDownloadListener() {
        if (this.bridge == null || this.bridge.getWebView() == null) return;

        this.bridge.getWebView().setDownloadListener((url, userAgent, contentDisposition, mimetype, contentLength) -> {
            try {
                if (url == null || url.startsWith("blob:") || url.startsWith("data:")) {
                    return;
                }

                DownloadManager.Request request = new DownloadManager.Request(Uri.parse(url));
                if (mimetype != null && !mimetype.isEmpty()) {
                    request.setMimeType(mimetype);
                }
                String cookies = CookieManager.getInstance().getCookie(url);
                if (cookies != null) {
                    request.addRequestHeader("cookie", cookies);
                }
                if (userAgent != null) {
                    request.addRequestHeader("User-Agent", userAgent);
                }
                request.setDescription("Downloading file...");
                String filename = URLUtil.guessFileName(url, contentDisposition, mimetype);
                request.setTitle(filename);
                request.allowScanningByMediaScanner();
                request.setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED);
                request.setDestinationInExternalPublicDir(Environment.DIRECTORY_DOWNLOADS, filename);

                DownloadManager dm = (DownloadManager) getSystemService(DOWNLOAD_SERVICE);
                if (dm != null) {
                    dm.enqueue(request);
                    Toast.makeText(getApplicationContext(), "Downloading " + filename, Toast.LENGTH_SHORT).show();
                }
            } catch (Exception e) {
                Toast.makeText(getApplicationContext(), "Download error: " + e.getMessage(), Toast.LENGTH_LONG).show();
            }
        });
    }

    private void handleMainFrameError(WebView view, String failedUrl) {
        if (isFinishing() || isDestroyed()) return;

        SharedPreferences prefs = getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
        String customUrl = prefs.getString(KEY_SERVER_URL, null);

        // If a non-default custom dev server was configured and failed, show dialog
        if (customUrl != null && !customUrl.trim().isEmpty() && !isDefaultServerUrl(customUrl)) {
            try {
                Uri customUri = Uri.parse(customUrl.trim());
                if (failedUrl != null && customUri.getHost() != null && failedUrl.contains(customUri.getHost())) {
                    showServerUnreachableDialog(failedUrl);
                    return;
                }
            } catch (Exception ignored) {}
        }

        // For production remote URLs, Service Worker (sw.js) or WebView cache handles offline gracefully.
        // We do not show an error dialog or redirect to avoid breaking origin boundary.
    }

    private void showServerUnreachableDialog(String failedUrl) {
        if (isFinishing() || isDestroyed() || isServerDialogShowing) return;

        SharedPreferences prefs = getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
        String customUrl = prefs.getString(KEY_SERVER_URL, null);
        boolean hasCustom = customUrl != null && !customUrl.trim().isEmpty() && !isDefaultServerUrl(customUrl);
        if (!hasCustom) {
            // Never show Server Unreachable dialog for production users without a custom dev server
            return;
        }

        isServerDialogShowing = true;
        AlertDialog.Builder builder = new AlertDialog.Builder(this);
        builder.setTitle("Server Unreachable");
        builder.setMessage("Could not connect to:\n" + failedUrl + "\n\nIs your local development server running on the network?");

        builder.setPositiveButton("Retry", (dialog, which) -> {
            hasCustomLoadCompleted = false;
            if (bridge != null && bridge.getWebView() != null) {
                bridge.getWebView().reload();
            }
        });

        if (hasCustom) {
            builder.setNeutralButton("Reset Default", (dialog, which) -> {
                prefs.edit().remove(KEY_SERVER_URL).apply();
                String defaultUrl = bridge != null ? bridge.getServerUrl() : "https://localhost";
                if (!defaultUrl.isEmpty() && bridge != null && bridge.getWebView() != null) {
                    bridge.getWebView().loadUrl(defaultUrl);
                }
            });
        }

        builder.setNegativeButton("Dismiss", null);
        AlertDialog dialog = builder.create();
        dialog.setOnDismissListener(d -> isServerDialogShowing = false);
        dialog.show();
    }

    @Override
    public void onBackPressed() {
        if (this.bridge != null && this.bridge.getWebView() != null && this.bridge.getWebView().canGoBack()) {
            this.bridge.getWebView().goBack();
        } else {
            super.onBackPressed();
        }
    }
}
