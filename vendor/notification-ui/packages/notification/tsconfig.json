{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@geeksman/core-ui": ["../../../core-ui/src"],
      "@geeksman/core-ui/*": ["../../../core-ui/src/*"]
    }
  },
  "include": ["src"]
}
